# ============================================================
# Configurações da Pipeline — TechChallenge 2
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Google Cloud — obrigatório para acessar o Base dos Dados via BigQuery
GCP_PROJECT_ID=seu-projeto-gcp

# Credenciais GCP (opcional se usar 'gcloud auth application-default login')
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service_account.json

# Kafka (opcional — necessário apenas para modo streaming com Kafka real)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
