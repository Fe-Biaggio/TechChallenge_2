# ============================================================
# Configurações da Pipeline — TechChallenge 2
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Google Cloud — opcional; se ausente ou inválido, a ingestão cai automaticamente
# para os CSVs em data/raw/ (ver pipeline/batch/01_ingestao_bronze.py)
#
# ATENÇÃO: isto é o Project ID do GCP (ex: "meu-projeto-123"), NÃO o Billing
# Account ID da sua conta de faturamento (formato "XXXX-XXXX-XXXX", encontrado
# em "Faturamento" no console do GCP). O billing_project_id exigido pela lib
# basedosdados é sempre um projeto — é preciso criar um projeto no GCP e
# vincular a conta de faturamento a ele; o ID desse projeto vai aqui.
GCP_PROJECT_ID=seu-projeto-gcp

# Credenciais GCP (opcional se usar 'gcloud auth application-default login')
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service_account.json

# Kafka (opcional — necessário apenas para modo streaming com Kafka real)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
